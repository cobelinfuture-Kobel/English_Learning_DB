    "A": {
      "name": "PRIMARY_CORE_BE_FAMILY",
      "purpose": "Choose the episode's most natural core be family: NP, adjective/state, or place. Do not force identity/category when the episode is naturally about state or location."
    },
    "B": {
      "name": "SECONDARY_BE_FAMILY",
      "purpose": "Use the strongest secondary be family that naturally exists in the same episode."
    },
    "C": {
      "name": "LOCATION_COMPLEMENT_FAMILY",
      "purpose": "Keep useful be + place/complement relations visible, especially concrete A1 location language."
    },
    "D": {
      "name": "SUBJECT_PRONOUN_BE_AGREEMENT_SHIFT",
      "purpose": "Preserve or safely infer the same meaning while shifting noun/name subjects to pronouns so subject-be agreement is visible in natural sentences."
    },
    "E": {
      "name": "AFFIRMATIVE_NEGATIVE_CONTRAST",
      "purpose": "Show meaningful polarity contrast using source truth first, then only safe semantic inference when needed."
    },
    "F": {
      "name": "CONNECTED_BE_SENTENCE_FAMILY",
      "purpose": "Connect compatible be facts into natural A1 sentences rather than isolated grammar-table rows."
    },
    "G": {
      "name": "CONTROLLED_CONTEXTUAL_TRANSFER",
      "purpose": "Transfer the same pattern to a nearby person, object, state, or place; every transfer example must be explicitly marked as not a Current360 source fact."
